# NeboTV relay settings. Copy to /etc/nebotv-relay.conf on the receiver and fill in.

[relay]
# Port the relay listens on. Forward this port on your router to the receiver.
port = 28080

# Shared secret: paste the one shown in the NeboTV panel (Sources > Satellite receiver).
secret =

# Different transponders (frequencies) that can play at once: the number of tuners.
# Channels on the same transponder share one tuner, so many more channels can play together.
max_streams = 2

# Both tuners fed by ONE dish cable (one DiSEqC switch)? Then the receiver can be on one satellite at a time,
# and a channel from another satellite is refused at once while something else is playing. Leave "no" when
# each tuner has its own cable.
single_cable = no

# The receiver's stream login (OpenWebif "authentication for streaming" is on):
# usually root and the box's root password.
box_user = root
box_password =

# Only if the OpenWebif web interface itself asks for a password from the box itself:
webif_user =
webif_password =

# Bouquets to offer, one per line, exactly as named on the receiver.
# Paid and card-sharing bouquets must not be shared.
bouquets =
    • 13,0 E - RAI • Mediaset • TivùSat

# Leave out channels that are encrypted (keeps free-to-air only).
fta_only = yes

# Address viewers use, e.g. http://nebotv-home.duckdns.org:28080
# (empty = taken from the request)
public_url =

[duckdns]
# Keeps <domain>.duckdns.org pointed at your home IP. Leave empty to skip.
domain =
token =
