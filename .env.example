APP_NAME=NeboTV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iptv_service
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Source imports can take up to 10 minutes; keep above SyncSource::$timeout (600)
DB_QUEUE_RETRY_AFTER=900
# Shared hosting without a queue worker: process imports from the schedule:run cron
QUEUE_SCHEDULED_WORKER=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# First admin, created by db:seed when it doesn't exist. Without ADMIN_PASSWORD: "admin123"
# locally, a random password (printed once) anywhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Alert emails. Brevo: MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_USERNAME = your Brevo SMTP login, MAIL_PASSWORD = an SMTP key (Brevo → SMTP & API),
# MAIL_FROM_ADDRESS = a sender verified in Brevo. "log" writes emails to storage/logs instead.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Minutes a signed satellite-receiver link stays valid (docs/features/receiver.md)
RECEIVER_LINK_MINUTES=180

# Days before a subscription ends that you get a reminder
EXPIRY_REMINDER_DAYS=3

# Who gets alert emails (comma-separated). Empty = alerts only show in the panel.
ALERT_MAIL_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
