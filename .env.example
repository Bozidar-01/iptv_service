APP_NAME=NeboTV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iptv_service
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Behind a load balancer or Cloudflare: * or a comma-separated list of proxy IPs
TRUSTED_PROXIES=
# Set to true when the panel runs on HTTPS (also sends the HSTS header)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Source imports can take up to 10 minutes; keep above SyncSource::$timeout (600)
DB_QUEUE_RETRY_AFTER=900
# Shared hosting without a queue worker: process imports from the schedule:run cron
QUEUE_SCHEDULED_WORKER=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# First admin, created by db:seed when it doesn't exist. Without ADMIN_PASSWORD: "admin123"
# locally, a random password (printed once) anywhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Alert emails. Brevo: MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_USERNAME = your Brevo SMTP login, MAIL_PASSWORD = an SMTP key (Brevo → SMTP & API),
# MAIL_FROM_ADDRESS = a sender verified in Brevo. "log" writes emails to storage/logs instead.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Minutes a signed satellite-receiver link stays valid (docs/features/receiver.md)
RECEIVER_LINK_MINUTES=180

# Days of TV guide kept and sent to apps
EPG_DAYS=3

# Days before a subscription ends that you get a reminder
# Subscribers with an email address get the expiry reminder too; this line is added to their email
REMINDER_EMAIL_USERS=true
RENEWAL_CONTACT=
EXPIRY_REMINDER_DAYS=3

# Trial accounts a reseller can make per 24 hours (admins are not limited)
TRIALS_PER_DAY=5

# A login used from at least this many different IP addresses within SHARING_HOURS raises a sharing alert (0 = off)
SHARING_IPS=3
SHARING_HOURS=24

# Daily housekeeping: delete a trial this many days after it ended; switch off a subscriber this many days after the
# subscription ended (0 = never)
TRIAL_KEEP_DAYS=7
EXPIRED_DISABLE_DAYS=60

# Who gets alert emails (comma-separated). Empty = alerts only show in the panel.
ALERT_MAIL_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Backblaze B2 / Cloudflare R2 / Wasabi: the provider's S3 address, e.g. https://s3.eu-central-003.backblazeb2.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Days of play history kept, and player-link request limits per minute
LOG_RETENTION_DAYS=90
THROTTLE_PER_TOKEN=60
THROTTLE_PER_IP=300
THROTTLE_STREAM_PER_TOKEN=600
THROTTLE_API_PER_IP=600

# Hide provider addresses: off | php | nginx. Only sources with "Hide provider address" are affected.
# php works anywhere but holds a PHP worker per viewer; nginx needs docker/nginx/stream-proxy.conf. See docs.
STREAM_PROXY=off
# Let the proxy fetch from private / local network addresses (off = refused, protects your own network)
PROXY_ALLOW_PRIVATE=false
PROXY_STREAMS_PER_DEVICE=3

# Database backups (php artisan iptv:backup, nightly at 02:30). BACKUP_DISK can be an off-site disk
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
# Also copy every backup to a second disk, normally off-site: s3 (needs the AWS_* settings below)
BACKUP_COPY_DISK=

# Error tracking: leave empty to turn off (see docs/deployment.md#error-tracking)
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
